#!/usr/bin/env bash
# ==============================================================================
# UniNet - Lightweight University Wi-Fi Auto-Connect Engine
#
# Supported Networks:
#   - UoM_Wireless
#   - UoM.Wireless
#   - UoM-Wireless
#
# Zero Python runtime, zero pip packages. Pure Linux coreutils + curl.
# ==============================================================================

set -eo pipefail

VERSION="1.0.8"
REPO_RAW_URL="https://raw.githubusercontent.com/dineTH2003-dev/uninet/main"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/uninet"
USER_CREDS="$CONFIG_DIR/credentials.json"
SYSTEM_CREDS="/etc/uninet/credentials.json"
COOKIE_JAR="/tmp/uninet_cookies_$UID.txt"
PROBE_URL="http://connectivitycheck.gstatic.com/generate_204"

# University SSIDs to match
MATCH_PATTERNS=("uom_wireless" "uom.wireless" "uom-wireless" "uom" "wireless" "campus")

# Terminal colors (disabled if not in terminal)
if [ -t 1 ]; then
    BOLD="\033[1m"
    GREEN="\033[32m"
    YELLOW="\033[33m"
    CYAN="\033[36m"
    RED="\033[31m"
    RESET="\033[0m"
else
    BOLD=""
    GREEN=""
    YELLOW=""
    CYAN=""
    RED=""
    RESET=""
fi

log() {
    echo -e "${CYAN}[UniNet]${RESET} $*"
}

# 1. Get currently connected Wi-Fi SSID
get_active_ssid() {
    if command -v nmcli &>/dev/null; then
        nmcli -t -f ACTIVE,SSID dev wifi 2>/dev/null | grep '^yes:' | cut -d':' -f2 | head -n 1 || true
    else
        echo ""
    fi
}

# 2. Check if SSID matches university patterns
is_university_network() {
    local ssid="$1"
    local ssid_lower="${ssid,,}"
    for pat in "${MATCH_PATTERNS[@]}"; do
        if [[ "$ssid_lower" == *"$pat"* ]]; then
            return 0
        fi
    done
    return 1
}

# 3. Check if we already have direct internet access (HTTP 204)
is_online() {
    local code
    code="$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 4 "$PROBE_URL" || true)"
    [ "$code" = "204" ]
}

# 4. Resolve relative or absolute URL against a base URL
resolve_url() {
    local base="$1"
    local target="$2"

    if [[ "$target" =~ ^https?:// ]]; then
        echo "$target"
        return
    fi

    local proto_host
    proto_host="$(echo "$base" | grep -o -E '^https?://[^/?#]+')"

    if [ -z "$proto_host" ]; then
        echo "$target"
        return
    fi

    if [[ "$target" =~ ^/ ]]; then
        echo "${proto_host}${target}"
    elif [ -z "$target" ]; then
        echo "$base"
    else
        local base_dir
        base_dir="$(echo "$base" | sed -E 's|\?.*$||; s|/[^/]*$||')"
        echo "${base_dir}/${target}"
    fi
}

# 4. Read credentials safely from user or system config
get_credentials() {
    local target_file=""
    if [ -f "$USER_CREDS" ]; then
        target_file="$USER_CREDS"
    elif [ -f "$SYSTEM_CREDS" ]; then
        target_file="$SYSTEM_CREDS"
    else
        # If running as root (dispatcher), search home directories
        for f in /home/*/.config/uninet/credentials.json; do
            if [ -f "$f" ]; then
                target_file="$f"
                break
            fi
        done
    fi

    if [ -z "$target_file" ] || [ ! -f "$target_file" ]; then
        return 1
    fi

    USERNAME="$(grep -o '"username"[[:space:]]*:[[:space:]]*"[^"]*"' "$target_file" | head -n 1 | cut -d'"' -f4)"
    PASSWORD="$(grep -o '"password"[[:space:]]*:[[:space:]]*"[^"]*"' "$target_file" | head -n 1 | cut -d'"' -f4)"

    [ -n "$USERNAME" ] && [ -n "$PASSWORD" ]
}

# 5. Core Login Flow
cmd_login() {
    local quiet=0
    if [ "$1" = "--quiet" ] || [ "$1" = "-q" ]; then
        quiet=1
    fi

    local ssid
    ssid="$(get_active_ssid)"

    if [ -z "$ssid" ]; then
        if [ $quiet -eq 0 ]; then
            log "No active Wi-Fi connection detected. Scanning for campus networks..."
            local campus_res
            campus_res="$(scan_networks "campus" 2>/dev/null || true)"
            if [ -n "$campus_res" ]; then
                cmd_optimize "$@"
                return
            else
                log "No university Wi-Fi networks found in range."
            fi
        fi
        exit 0
    fi

    # 2ms exit if not on university network
    if ! is_university_network "$ssid"; then
        [ $quiet -eq 0 ] && log "Connected to non-university Wi-Fi ($ssid). Exiting."
        exit 0
    fi

    # Check if already online
    if is_online; then
        [ $quiet -eq 0 ] && log "${GREEN}Already connected to the internet on $ssid.${RESET}"
        exit 0
    fi

    [ $quiet -eq 0 ] && log "Captive portal detected on ${BOLD}$ssid${RESET}. Authenticating..."

    if ! get_credentials; then
        log "${RED}Error: No saved credentials found. Run 'uninet setup' first.${RESET}"
        exit 1
    fi

    # Probe portal to capture redirect URL, final destination, and session cookies
    rm -f "$COOKIE_JAR"
    local probe_tmp
    probe_tmp="$(mktemp)"
    local effective_url
    effective_url="$(curl -s -k -c "$COOKIE_JAR" -L --max-redirs 5 --connect-timeout 8 -w "%{url_effective}" "$PROBE_URL" -o "$probe_tmp" 2>/dev/null || true)"
    local probe_output
    probe_output="$(cat "$probe_tmp" 2>/dev/null || true)"
    rm -f "$probe_tmp"

    local location_url
    location_url="$(echo "$probe_output" | grep -i '^Location:' | tail -n 1 | awk '{print $2}' | tr -d '\r\n')"

    local portal_base_url="${effective_url:-$location_url}"
    portal_base_url="${portal_base_url:-$PROBE_URL}"

    # Handle HTML meta-refresh or javascript redirect if present
    local meta_url
    meta_url="$(echo "$probe_output" | grep -i -o '<meta[^>]*http-equiv=["'\''"]refresh["'\''"][^>]*' | grep -i -o 'url=[^"'\'' >]*' | head -n 1 | cut -d'=' -f2- | tr -d '"'\'' || true)"
    if [ -n "$meta_url" ]; then
        local resolved_meta
        resolved_meta="$(resolve_url "$portal_base_url" "$meta_url")"
        if [ -n "$resolved_meta" ] && [ "$resolved_meta" != "$portal_base_url" ]; then
            portal_base_url="$resolved_meta"
            probe_tmp="$(mktemp)"
            effective_url="$(curl -s -k -b "$COOKIE_JAR" -c "$COOKIE_JAR" -L --max-redirs 5 --connect-timeout 8 -w "%{url_effective}" "$portal_base_url" -o "$probe_tmp" 2>/dev/null || true)"
            probe_output="$(cat "$probe_tmp" 2>/dev/null || true)"
            rm -f "$probe_tmp"
            portal_base_url="${effective_url:-$portal_base_url}"
        fi
    fi

    # Extract form action URL and resolve against portal base URL
    local raw_action
    raw_action="$(echo "$probe_output" | grep -i -o '<form[^>]*action=["'\''"][^"'\'']*["'\'']' | head -n 1 | sed -E 's/.*action=["'\''"]([^"'\'']*)["'\''"].*/\1/' || true)"

    local action_url
    action_url="$(resolve_url "$portal_base_url" "$raw_action")"
    if [ -z "$action_url" ]; then
        action_url="$portal_base_url"
    fi

    [ $quiet -eq 0 ] && log "Submitting login credentials for ${BOLD}$USERNAME${RESET}..."

    # Build intelligent, multi-vendor payload
    local curl_data=()

    # 1. Extract hidden form fields (CSRF tokens, session IDs, gateway params)
    while IFS='=' read -r h_name h_val; do
        if [ -n "$h_name" ]; then
            curl_data+=(--data-urlencode "$h_name=$h_val")
        fi
    done < <(echo "$probe_output" | grep -i -o '<input[^>]*>' | while read -r tag; do
        if echo "$tag" | grep -iq 'type=["'\''"]\?hidden'; then
            local n v
            n="$(echo "$tag" | sed -E -n 's/.*name=["'\''"]([^"'\''>[:space:]]+)["'\''"].*/\1/p')"
            v="$(echo "$tag" | sed -E -n 's/.*value=["'\''"]([^"'\''>]*).*/\1/p')"
            [ -n "$n" ] && echo "$n=$v"
        fi
    done)

    # 2. Inject username based on detected form field names
    if echo "$probe_output" | grep -iq 'name=[^>]*username'; then
        curl_data+=(--data-urlencode "username=$USERNAME")
    fi
    if echo "$probe_output" | grep -iq 'name=[^>]*[^a-z]user[^a-z]'; then
        curl_data+=(--data-urlencode "user=$USERNAME")
    fi
    # Fallback if neither found
    if ! echo "$probe_output" | grep -iqE 'name=[^>]*(username|[^a-z]user[^a-z])'; then
        curl_data+=(--data-urlencode "username=$USERNAME" --data-urlencode "user=$USERNAME")
    fi

    # 3. Inject password
    if echo "$probe_output" | grep -iq 'name=[^>]*password'; then
        curl_data+=(--data-urlencode "password=$PASSWORD")
    elif echo "$probe_output" | grep -iq 'name=[^>]*pass[^w]'; then
        curl_data+=(--data-urlencode "pass=$PASSWORD")
    else
        curl_data+=(--data-urlencode "password=$PASSWORD")
    fi

    # 4. Vendor-specific payload injection
    # --- Cisco/NEC WebAuth portal (UoM_Wireless, UoM-Wireless) ---
    # Portal title: "Web Authentication"
    # Form action:  /login.html
    # Key field:    buttonClicked=4 (from loginscript.js submitAction function)
    # Hidden fields: buttonClicked, err_flag, err_msg, info_flag, info_msg,
    #                redirect_url, network_name
    if [[ "$action_url" == *"/login.html"* ]] || \
       echo "$probe_output" | grep -iq 'name=[^>]*buttonClicked'; then
        # Remove any auto-extracted buttonClicked (value=0) and force it to 4
        local filtered_data=()
        local skip_next=0
        for item in "${curl_data[@]}"; do
            if [ "$skip_next" -eq 1 ]; then
                skip_next=0
                continue
            fi
            if [ "$item" = "--data-urlencode" ]; then
                filtered_data+=("$item")
            elif [[ "$item" == buttonClicked=* ]] || [[ "$item" == err_flag=1* ]]; then
                # Remove the preceding --data-urlencode flag too
                unset 'filtered_data[-1]'
                skip_next=0
            else
                filtered_data+=("$item")
            fi
        done
        curl_data=("${filtered_data[@]}")
        curl_data+=(--data-urlencode "buttonClicked=4")
        curl_data+=(--data-urlencode "err_flag=0")
        [ $quiet -eq 0 ] && log "Detected Cisco/NEC WebAuth portal (UoM_Wireless). Using buttonClicked=4..."
    fi

    # --- Aruba Networks portal (UoM.Wireless) ---
    # Portal served by Aruba controller, action: /cgi-bin/login
    if [[ "$action_url" == *"cgi-bin/login"* ]] || [[ "${ssid,,}" == *"uom.wireless"* ]]; then
        if ! [[ "${curl_data[*]}" == *"cmd="* ]]; then
            curl_data+=(--data-urlencode "cmd=authenticate")
        fi
        if ! [[ "${curl_data[*]}" == *"user="* ]]; then
            curl_data+=(--data-urlencode "user=$USERNAME")
        fi
        curl_data+=(--data-urlencode "Login=Log In")
        [ $quiet -eq 0 ] && log "Detected Aruba Networks portal (UoM.Wireless). Using cmd=authenticate..."
    fi

    # 5. Submit authentication request
    curl -s -k -b "$COOKIE_JAR" -c "$COOKIE_JAR" \
        -X POST \
        "${curl_data[@]}" \
        --max-time 10 \
        "$action_url" > /dev/null 2>&1 || true

    rm -f "$COOKIE_JAR"

    # Confirm post-login status
    sleep 1
    if is_online; then
        [ $quiet -eq 0 ] && log "${GREEN}✔ Successfully connected! Internet is now active on $ssid.${RESET}"
        exit 0
    else
        # Allow a 2-second gateway settling grace period
        sleep 2
        if is_online; then
            [ $quiet -eq 0 ] && log "${GREEN}✔ Successfully connected! Internet is now active on $ssid.${RESET}"
            exit 0
        fi
        [ $quiet -eq 0 ] && log "${YELLOW}Notice: Credentials submitted. Checking connection...${RESET}"
        exit 0
    fi
}

# 6. Status check
check_version_notification() {
    [ -t 1 ] || return 0
    is_online || return 0

    local latest_ver
    latest_ver="$(curl -fsSL --connect-timeout 1 --max-time 1.5 "$REPO_RAW_URL/VERSION" 2>/dev/null | tr -d '[:space:]' || true)"

    if [ -n "$latest_ver" ] && [ "$latest_ver" != "$VERSION" ]; then
        echo -e "\n${YELLOW}💡 A new version of UniNet is available (v${latest_ver}).${RESET}"
        echo -e "   Run ${BOLD}uninet update${RESET} to upgrade automatically."
    fi
}

cmd_status() {
    local ssid
    ssid="$(get_active_ssid)"
    echo -e "${BOLD}${CYAN}=== UniNet Status ===${RESET}"
    echo -e "${BOLD}Active Wi-Fi:${RESET}   ${ssid:-None}"

    if [ -n "$ssid" ]; then
        if is_university_network "$ssid"; then
            echo -e "${BOLD}University Net:${RESET} ${GREEN}Yes ($ssid)${RESET}"
        else
            echo -e "${BOLD}University Net:${RESET} ${YELLOW}No (Home/Other)${RESET}"
        fi
    fi

    if is_online; then
        echo -e "${BOLD}Internet:${RESET}       ${GREEN}ONLINE (Direct Internet Access confirmed)${RESET}"
    else
        echo -e "${BOLD}Internet:${RESET}       ${YELLOW}CAPTIVE PORTAL / OFFLINE${RESET}"
    fi

    check_version_notification
}

# 7. University of Moratuwa Official Terminal Crest & Setup Wizard
print_uom_logo() {
    # Check if assets file exists locally, otherwise decompress embedded TrueColor logo
    local asset_file="/usr/local/share/uninet/uom_logo.ans"
    if [ -f "$asset_file" ]; then
        cat "$asset_file"
        return
    fi

    local b64=""
    echo "$b64" | (base64 -d 2>/dev/null || base64 -D 2>/dev/null) | gzip -d 2>/dev/null || true
}

cmd_setup() {
    print_uom_logo
    echo -e "${BOLD}${CYAN}========================================================${RESET}"
    echo -e "${BOLD}${CYAN}         UNIVERSITY OF MORATUWA • CAMPUS WI-FI          ${RESET}"
    echo -e "${BOLD}${CYAN}               UniNet Auto-Connect Engine               ${RESET}"
    echo -e "${BOLD}${CYAN}========================================================${RESET}\n"

    local current_ssid
    current_ssid="$(get_active_ssid)"
    if [ -n "$current_ssid" ]; then
        echo -e "Active Wi-Fi: ${BOLD}$current_ssid${RESET}\n"
    fi

    local user_in=""
    local pass_in=""

    if [ -e /dev/tty ]; then
        exec 3</dev/tty
        read -u 3 -rp "Student Username      : " user_in
        read -u 3 -rsp "Network Password      : " pass_in
        echo ""
        exec 3<&-
    else
        read -rp "Student Username      : " user_in
        read -rsp "Network Password      : " pass_in
        echo ""
    fi

    if [ -z "$user_in" ]; then
        echo -e "${RED}Error: Username cannot be empty.${RESET}"
        exit 1
    fi

    if [ -z "$pass_in" ]; then
        echo -e "${RED}Error: Password cannot be empty.${RESET}"
        exit 1
    fi

    mkdir -p "$CONFIG_DIR"
    cat << EOF > "$USER_CREDS"
{
  "username": "$user_in",
  "password": "$pass_in"
}
EOF
    chmod 600 "$USER_CREDS"

    # Also save to system if sudo is available
    if [ -w "/etc" ] || command -v sudo &>/dev/null; then
        sudo mkdir -p /etc/uninet 2>/dev/null || true
        sudo cp "$USER_CREDS" "$SYSTEM_CREDS" 2>/dev/null || true
        sudo chmod 600 "$SYSTEM_CREDS" 2>/dev/null || true
    fi

    # Register UoM SSIDs as trusted networks for auto-join
    cmd_trust_networks

    # Quiet connection test if currently connected to a campus network
    if [ -n "$current_ssid" ] && is_university_network "$current_ssid"; then
        if ! is_online; then
            cmd_login -q 2>/dev/null || true
        fi
    fi

    echo -e "\n${BOLD}${GREEN}========================================================"
    echo -e "✔ Credentials securely saved!"
    echo -e "✨ You are all set!"
    echo -e ""
    echo -e "Your machine will now automatically join university Wi-Fi"
    echo -e "whenever it is in range — no manual selection needed:"
    echo -e "  • UoM_Wireless"
    echo -e "  • UoM.Wireless"
    echo -e "  • UoM-Wireless"
    echo -e "UniNet will authenticate the portal in the background!"
    echo -e "========================================================${RESET}\n"
}

# 9a. Trust UoM Networks — register open WLAN profiles for auto-join
cmd_trust_networks() {
    if ! command -v nmcli &>/dev/null; then
        return
    fi

    local ssids=("UoM_Wireless" "UoM.Wireless" "UoM-Wireless")
    local modified=0
    local added=0

    for ssid in "${ssids[@]}"; do
        local found=0
        # Check if any profiles already exist for this SSID (including numeric variants)
        while IFS= read -r con_name; do
            if [ -n "$con_name" ]; then
                found=1
                nmcli connection modify "$con_name" \
                    connection.autoconnect yes \
                    connection.autoconnect-priority 100 \
                    connection.autoconnect-retries -1 2>/dev/null || true
                modified=$((modified + 1))
            fi
        done < <(nmcli -t -f NAME connection show 2>/dev/null | grep -E "^${ssid}(\s+[0-9]+)?$" || true)

        # If no profile exists yet, create one with priority 100
        if [ "$found" -eq 0 ]; then
            if nmcli connection add \
                type wifi \
                con-name "$ssid" \
                ssid "$ssid" \
                connection.autoconnect yes \
                connection.autoconnect-priority 100 \
                connection.autoconnect-retries -1 \
                802-11-wireless.mode infrastructure \
                ipv4.method auto \
                ipv6.method auto \
                -- 2>/dev/null; then
                added=$((added + 1))
            fi
        fi
    done

    if [ "$modified" -gt 0 ] || [ "$added" -gt 0 ]; then
        log "Enforced auto-connect & priority 100 for campus profiles ($modified updated, $added created)."
    fi
}

# 8. Wi-Fi Multi-Factor Quality Scoring & Network Scanning
calculate_ap_score() {
    local sig="$1" freq="$2" rate="$3" active="$4"
    # 1. Signal quality (35% weight: 0 - 350 pts)
    local sig_score=$((sig * 35 / 10))

    # 2. Band bonus: 5GHz/6GHz gets +300 pts (if signal >= 20%)
    local band_bonus=0
    if [ "$freq" -ge 5000 ] && [ "$sig" -ge 20 ]; then
        band_bonus=300
    fi

    # 3. Advertised PHY rate (35% weight: min(rate, 866) / 866 * 350 pts)
    [ "$rate" -gt 866 ] && rate=866
    local rate_score=$((rate * 350 / 866))

    # 4. Active connection stability bonus (+120 pts / 12.0 pts)
    local act_bonus=0
    [ "$active" -eq 1 ] && act_bonus=120

    echo $((sig_score + band_bonus + rate_score + act_bonus))
}

scan_networks() {
    local filter_mode="${1:-campus}"
    if ! command -v nmcli &>/dev/null; then
        return
    fi

    local in_use="" ssid="" bssid="" freq="" rate="" signal=""
    while IFS= read -r line || [ -n "$line" ]; do
        local key="${line%%:*}"
        local val="${line#*:}"
        val="$(echo "$val" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

        case "$key" in
            IN-USE) in_use="$val" ;;
            SSID)   ssid="$val" ;;
            BSSID)  bssid="$val" ;;
            FREQ)   freq="$val" ;;
            RATE)   rate="$val" ;;
            SIGNAL)
                signal="$val"
                if [ -n "$ssid" ]; then
                    local include=0
                    if [ "$filter_mode" = "all" ]; then
                        include=1
                    elif is_university_network "$ssid"; then
                        include=1
                    fi

                    if [ "$include" -eq 1 ]; then
                        local is_active=0
                        [ "$in_use" = "*" ] && is_active=1

                        local freq_num="${freq//[^0-9]/}"
                        local rate_num="${rate//[^0-9]/}"
                        local sig_num="${signal//[^0-9]/}"

                        freq_num="${freq_num:-2412}"
                        rate_num="${rate_num:-54}"
                        sig_num="${sig_num:-0}"

                        local band_label="2.4 GHz"
                        if [ "$freq_num" -ge 5925 ]; then
                            band_label="6.0 GHz"
                        elif [ "$freq_num" -ge 5000 ]; then
                            band_label="5.0 GHz"
                        fi

                        local score
                        score="$(calculate_ap_score "$sig_num" "$freq_num" "$rate_num" "$is_active")"

                        printf "%d\t%d\t%s\t%s\t%s\t%s\t%s\t%s\n" \
                            "$score" "$is_active" "$ssid" "$bssid" "$band_label" "$rate" "$signal" "$freq_num"
                    fi
                fi
                in_use=""; ssid=""; bssid=""; freq=""; rate=""; signal=""
                ;;
        esac
    done < <(nmcli -m multiline -f IN-USE,SSID,BSSID,FREQ,RATE,SIGNAL dev wifi list 2>/dev/null || true)
}

# 9. Scan & Optimize Commands
cmd_scan() {
    log "Scanning for available Wi-Fi networks..."
    local results
    results="$(scan_networks "campus")"

    if [ -z "$results" ]; then
        echo -e "${YELLOW}Notice: No university campus networks detected in range.${RESET}"
        echo -e "Showing nearby Wi-Fi networks for diagnosis:\n"
        results="$(scan_networks "all")"
    else
        echo -e "\n${BOLD}Detected Campus Networks:${RESET}"
    fi

    if [ -z "$results" ]; then
        echo "No Wi-Fi networks found."
        return
    fi

    # Sort results by score descending (numeric sort)
    local sorted
    sorted="$(echo "$results" | sort -t$'\t' -k1,1nr)"

    # Check active score to highlight better candidates
    local active_score=0
    while IFS=$'\t' read -r sc act ss bs bnd rt sig fq; do
        if [ "$act" -eq 1 ]; then
            active_score=$(( 10#${sc:-0} ))
            break
        fi
    done <<< "$sorted"

    printf "${BOLD}%-9s %-18s %-18s %-9s %-12s %-8s %-6s${RESET}\n" \
        "STATUS" "SSID" "BSSID" "BAND" "RATE" "SIGNAL" "SCORE"
    echo "----------------------------------------------------------------------------------"

    while IFS=$'\t' read -r sc act ss bs bnd rt sig fq; do
        local sc_num=$(( 10#${sc:-0} ))
        local display_score
        display_score="$(awk -v s="$sc_num" 'BEGIN { printf "%.1f", s / 10 }')"

        local status="      "
        local suffix=""
        if [ "$act" -eq 1 ]; then
            status="* ACTIVE"
        elif [ "$active_score" -gt 0 ] && [ "$sc_num" -ge "$((active_score + 150))" ]; then
            status="  BETTER"
            suffix=" 🚀"
        fi

        printf "%-9s %-18s %-18s %-9s %-12s %-8s %-6s%s\n" \
            "$status" "${ss:0:18}" "$bs" "$bnd" "$rt" "${sig}%" "$display_score" "$suffix"
    done <<< "$sorted"
    echo ""
    check_version_notification
}

cmd_optimize() {
    log "Evaluating campus Wi-Fi networks for optimal bandwidth and speed..."
    local results
    results="$(scan_networks "campus")"

    if [ -z "$results" ]; then
        log "No university networks detected in range. Checking standard login..."
        cmd_login "$@"
        return
    fi

    local sorted
    sorted="$(echo "$results" | sort -t$'\t' -k1,1nr)"

    local active_score=0 active_ssid="" active_bssid=""
    local top_score=0 top_ssid="" top_bssid="" top_band="" top_rate="" top_is_active=0

    # Read top candidate (first line)
    local first_line
    first_line="$(echo "$sorted" | head -n 1)"
    IFS=$'\t' read -r top_score top_is_active top_ssid top_bssid top_band top_rate _ _ <<< "$first_line"
    top_score=$(( 10#${top_score:-0} ))

    # Find currently active AP
    while IFS=$'\t' read -r sc act ss bs bnd rt sig fq; do
        if [ "$act" -eq 1 ]; then
            active_score=$(( 10#${sc:-0} ))
            active_ssid=$ss
            active_bssid=$bs
            break
        fi
    done <<< "$sorted"

    # Hysteresis threshold: 15.0 pts (+150 in x10 scale)
    local threshold=$((active_score + 150))

    if [ "$active_score" -eq 0 ]; then
        log "Connecting to campus Wi-Fi '$top_ssid' ($top_band, $top_rate)..."
        if nmcli dev wifi connect "$top_ssid" bssid "$top_bssid" 2>&1; then
            echo -e "${GREEN}✔ Successfully connected to $top_ssid!${RESET}"
            sleep 1
        else
            echo -e "${YELLOW}Warning: Connection attempt to $top_ssid failed.${RESET}"
        fi
    elif [ "$top_is_active" -eq 1 ] || [ "$top_bssid" = "$active_bssid" ]; then
        local display_active
        display_active="$(awk -v s="$active_score" 'BEGIN { printf "%.1f", s / 10 }')"
        log "Current connection '$active_ssid' is already the best available (Quality Score: $display_active)."
    elif [ "$top_score" -ge "$threshold" ]; then
        local diff=$((top_score - active_score))
        local display_diff
        display_diff="$(awk -v d="$diff" 'BEGIN { printf "%.1f", d / 10 }')"
        log "${BOLD}Found significantly faster connection: '$top_ssid' (+$display_diff pts higher quality, $top_band, $top_rate).${RESET}"
        log "Switching connection to '$top_ssid' ($top_bssid)..."
        if nmcli dev wifi connect "$top_ssid" bssid "$top_bssid" 2>&1; then
            echo -e "${GREEN}✔ Successfully connected to $top_ssid!${RESET}"
            sleep 1
        else
            echo -e "${YELLOW}Warning: Connection switch failed. Falling back to active network.${RESET}"
        fi
    else
        log "Current connection '$active_ssid' is optimal (candidate difference is within the 15-point stability margin)."
    fi

    log "Probing captive portal..."
    cmd_login "$@"
}

# 10. Uninstaller
cmd_uninstall() {
    echo -e "${YELLOW}Uninstalling UniNet — removing all files and settings...${RESET}"
    echo ""

    # Remove credentials and config
    if rm -f "$USER_CREDS" 2>/dev/null && rm -rf "$CONFIG_DIR" 2>/dev/null; then
        echo -e "  ${GREEN}✔${RESET} Credentials and config removed"
    fi

    # Remove system files (requires sudo)
    if command -v sudo &>/dev/null; then
        sudo rm -f /etc/NetworkManager/dispatcher.d/99-uninet.sh 2>/dev/null && \
            echo -e "  ${GREEN}✔${RESET} Dispatcher hook removed" || \
            echo -e "  ${YELLOW}⚠${RESET} Could not remove dispatcher hook (sudo required)"
        sudo rm -rf /etc/uninet 2>/dev/null || true
        sudo rm -f /usr/local/bin/uninet 2>/dev/null && \
            echo -e "  ${GREEN}✔${RESET} System binary removed" || true
        sudo rm -rf /usr/local/share/uninet 2>/dev/null || true
        sudo rm -f /var/log/uninet.log 2>/dev/null || true
    fi

    # Remove user binary
    rm -f "$HOME/.local/bin/uninet" 2>/dev/null && \
        echo -e "  ${GREEN}✔${RESET} User binary removed" || true

    # Remove NetworkManager Wi-Fi profiles
    if command -v nmcli &>/dev/null; then
        for ssid in "UoM_Wireless" "UoM.Wireless" "UoM-Wireless"; do
            if nmcli connection delete "$ssid" 2>/dev/null; then
                echo -e "  ${GREEN}✔${RESET} Wi-Fi profile removed: $ssid"
            fi
        done
    fi

    echo ""
    echo -e "${GREEN}✔ UniNet has been completely uninstalled from this machine.${RESET}"
}

# 11. Self-Updater
cmd_update() {
    log "Checking for updates..."
    local latest_ver
    latest_ver="$(curl -fsSL --connect-timeout 4 --max-time 6 "$REPO_RAW_URL/VERSION" 2>/dev/null | tr -d '[:space:]' || true)"

    if [ -z "$latest_ver" ]; then
        echo -e "${RED}Error: Unable to fetch latest version information. Please check your internet connection.${RESET}"
        return 1
    fi

    if [ "$latest_ver" = "$VERSION" ]; then
        echo -e "${GREEN}✔ UniNet is already up to date (v$VERSION).${RESET}"
        return 0
    fi

    echo -e "Found newer version: ${BOLD}v${latest_ver}${RESET} (current: v${VERSION}). Upgrading..."

    local temp_bin
    temp_bin="$(mktemp)"
    # Try downloading release asset first (increments GitHub release download counter)
    if ! curl -fsSL --connect-timeout 5 --max-time 15 "https://github.com/dineTH2003-dev/uninet/releases/download/v${latest_ver}/uninet" -o "$temp_bin" 2>/dev/null || ! [ -s "$temp_bin" ]; then
        if ! curl -fsSL --connect-timeout 5 --max-time 15 "$REPO_RAW_URL/bin/uninet" -o "$temp_bin"; then
            rm -f "$temp_bin"
            echo -e "${RED}Error: Failed to download update from GitHub.${RESET}"
            return 1
        fi
    fi

    if ! head -n 1 "$temp_bin" | grep -q "bash"; then
        rm -f "$temp_bin"
        echo -e "${RED}Error: Downloaded file corrupted or invalid.${RESET}"
        return 1
    fi

    chmod +x "$temp_bin"

    # Update installed locations
    local updated=0
    if [ -f "$HOME/.local/bin/uninet" ] || [ -L "$HOME/.local/bin/uninet" ] || [ -w "$HOME/.local/bin" ]; then
        mkdir -p "$HOME/.local/bin"
        rm -f "$HOME/.local/bin/uninet"
        cp "$temp_bin" "$HOME/.local/bin/uninet"
        chmod 755 "$HOME/.local/bin/uninet"
        updated=$((updated + 1))
    fi

    if [ -f "/usr/local/bin/uninet" ] || [ -w "/usr/local/bin" ]; then
        if [ -w "/usr/local/bin" ]; then
            rm -f "/usr/local/bin/uninet"
            cp "$temp_bin" "/usr/local/bin/uninet"
            chmod 755 "/usr/local/bin/uninet"
            updated=$((updated + 1))
        elif command -v sudo &>/dev/null; then
            if sudo cp "$temp_bin" "/usr/local/bin/uninet" 2>/dev/null; then
                sudo chmod 755 "/usr/local/bin/uninet" 2>/dev/null || true
                updated=$((updated + 1))
            fi
        fi
    fi

    rm -f "$temp_bin"

    if [ "$updated" -gt 0 ]; then
        echo -e "${GREEN}✔ Successfully updated UniNet to v${latest_ver}!${RESET}"
    else
        echo -e "${YELLOW}Warning: Update downloaded but could not write to binary path.${RESET}"
    fi
}

# 12. CLI Route
case "$1" in
    login)
        shift
        cmd_login "$@"
        ;;
    optimize|best)
        shift
        cmd_optimize "$@"
        ;;
    scan)
        cmd_scan
        ;;
    status)
        cmd_status
        ;;
    setup)
        cmd_setup
        ;;
    trust)
        cmd_trust_networks
        ;;
    update)
        cmd_update
        ;;
    uninstall)
        cmd_uninstall
        ;;
    --version|-v)
        echo "UniNet v$VERSION (Pure Bash Engine)"
        ;;
    "")
        cmd_login
        ;;
    --help|-h|*)
        echo -e "${BOLD}UniNet v$VERSION${RESET} - University Wi-Fi Auto-Connect"
        echo ""
        echo "Usage: uninet <command>"
        echo ""
        echo "Commands:"
        echo "  login        Authenticate with university Wi-Fi portal"
        echo "  optimize     Find and switch to highest speed/bandwidth campus AP"
        echo "  scan         List nearby campus Wi-Fi networks with quality scores"
        echo "  status       Check current Wi-Fi and internet status"
        echo "  setup        Configure student ID and password"
        echo "  trust        Register UoM SSIDs for automatic Wi-Fi join"
        echo "  update       Check for and install the latest UniNet version"
        echo "  uninstall    Remove UniNet and background hooks from machine"
        echo ""
        ;;
esac
