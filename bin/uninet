#!/usr/bin/env bash
# ==============================================================================
# UniNet - Lightweight University Wi-Fi Auto-Connect Engine
#
# Supported Networks:
#   - UoM_Wireless
#   - UoM.Wireless
#   - UoM-Wireless
#
# Zero Python runtime, zero pip packages. Pure Linux coreutils + curl.
# ==============================================================================

set -eo pipefail

VERSION="1.0.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/uninet"
USER_CREDS="$CONFIG_DIR/credentials.json"
SYSTEM_CREDS="/etc/uninet/credentials.json"
COOKIE_JAR="/tmp/uninet_cookies_$UID.txt"
PROBE_URL="http://connectivitycheck.gstatic.com/generate_204"

# University SSIDs to match
MATCH_PATTERNS=("uom_wireless" "uom.wireless" "uom-wireless" "uom" "wireless" "campus")

# Terminal colors (disabled if not in terminal)
if [ -t 1 ]; then
    BOLD="\033[1m"
    GREEN="\033[32m"
    YELLOW="\033[33m"
    CYAN="\033[36m"
    RED="\033[31m"
    RESET="\033[0m"
else
    BOLD=""
    GREEN=""
    YELLOW=""
    CYAN=""
    RED=""
    RESET=""
fi

log() {
    echo -e "${CYAN}[UniNet]${RESET} $*"
}

# 1. Get currently connected Wi-Fi SSID
get_active_ssid() {
    if command -v nmcli &>/dev/null; then
        nmcli -t -f ACTIVE,SSID dev wifi 2>/dev/null | grep '^yes:' | cut -d':' -f2 | head -n 1 || true
    else
        echo ""
    fi
}

# 2. Check if SSID matches university patterns
is_university_network() {
    local ssid="$1"
    local ssid_lower="${ssid,,}"
    for pat in "${MATCH_PATTERNS[@]}"; do
        if [[ "$ssid_lower" == *"$pat"* ]]; then
            return 0
        fi
    done
    return 1
}

# 3. Check if we already have direct internet access (HTTP 204)
is_online() {
    local code
    code="$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 4 "$PROBE_URL" || true)"
    [ "$code" = "204" ]
}

# 4. Read credentials safely from user or system config
get_credentials() {
    local target_file=""
    if [ -f "$USER_CREDS" ]; then
        target_file="$USER_CREDS"
    elif [ -f "$SYSTEM_CREDS" ]; then
        target_file="$SYSTEM_CREDS"
    else
        # If running as root (dispatcher), search home directories
        for f in /home/*/.config/uninet/credentials.json; do
            if [ -f "$f" ]; then
                target_file="$f"
                break
            fi
        done
    fi

    if [ -z "$target_file" ] || [ ! -f "$target_file" ]; then
        return 1
    fi

    USERNAME="$(grep -o '"username"[[:space:]]*:[[:space:]]*"[^"]*"' "$target_file" | head -n 1 | cut -d'"' -f4)"
    PASSWORD="$(grep -o '"password"[[:space:]]*:[[:space:]]*"[^"]*"' "$target_file" | head -n 1 | cut -d'"' -f4)"

    [ -n "$USERNAME" ] && [ -n "$PASSWORD" ]
}

# 5. Core Login Flow
cmd_login() {
    local quiet=0
    if [ "$1" = "--quiet" ] || [ "$1" = "-q" ]; then
        quiet=1
    fi

    local ssid
    ssid="$(get_active_ssid)"

    if [ -z "$ssid" ]; then
        [ $quiet -eq 0 ] && log "No active Wi-Fi connection detected."
        exit 0
    fi

    # 2ms exit if not on university network
    if ! is_university_network "$ssid"; then
        [ $quiet -eq 0 ] && log "Connected to non-university Wi-Fi ($ssid). Exiting."
        exit 0
    fi

    # Check if already online
    if is_online; then
        [ $quiet -eq 0 ] && log "${GREEN}Already connected to the internet on $ssid.${RESET}"
        exit 0
    fi

    [ $quiet -eq 0 ] && log "Captive portal detected on ${BOLD}$ssid${RESET}. Authenticating..."

    if ! get_credentials; then
        log "${RED}Error: No saved credentials found. Run 'uninet setup' first.${RESET}"
        exit 1
    fi

    # Probe portal to capture redirect URL and session cookies
    rm -f "$COOKIE_JAR"
    local probe_output
    probe_output="$(curl -s -i -c "$COOKIE_JAR" -L --max-redirs 5 --connect-timeout 8 "$PROBE_URL" 2>/dev/null || true)"
    
    local final_url
    final_url="$(echo "$probe_output" | grep -i '^Location:' | tail -n 1 | awk '{print $2}' | tr -d '\r\n')"

    # Extract form action URL
    local action_url
    action_url="$(echo "$probe_output" | grep -i -o '<form[^>]*action=["'\''"][^"'\'']*["'\'']' | head -n 1 | sed -E 's/.*action=["'\''"]([^"'\'']*)["'\''"].*/\1/')"

    if [ -z "$action_url" ] && [ -n "$final_url" ]; then
        action_url="$final_url"
    fi

    if [ -z "$action_url" ]; then
        action_url="${final_url:-$PROBE_URL}"
    fi

    [ $quiet -eq 0 ] && log "Submitting login credentials for ${BOLD}$USERNAME${RESET}..."

    # Submit login request with cookies and common university field names
    curl -s -k -b "$COOKIE_JAR" -c "$COOKIE_JAR" \
        -X POST \
        --data-urlencode "username=$USERNAME" \
        --data-urlencode "password=$PASSWORD" \
        --data-urlencode "user=$USERNAME" \
        --data-urlencode "pass=$PASSWORD" \
        --data-urlencode "student_id=$USERNAME" \
        --data-urlencode "student_password=$PASSWORD" \
        --max-time 10 \
        "$action_url" > /dev/null 2>&1 || true

    rm -f "$COOKIE_JAR"

    # Confirm post-login status
    sleep 1
    if is_online; then
        [ $quiet -eq 0 ] && log "${GREEN}✔ Successfully connected! Internet is now active on $ssid.${RESET}"
        exit 0
    else
        [ $quiet -eq 0 ] && log "${YELLOW}Notice: Credentials submitted. Checking connection...${RESET}"
        exit 0
    fi
}

# 6. Status check
cmd_status() {
    local ssid
    ssid="$(get_active_ssid)"
    echo -e "${BOLD}${CYAN}=== UniNet Status ===${RESET}"
    echo -e "${BOLD}Active Wi-Fi:${RESET}   ${ssid:-None}"

    if [ -n "$ssid" ]; then
        if is_university_network "$ssid"; then
            echo -e "${BOLD}University Net:${RESET} ${GREEN}Yes ($ssid)${RESET}"
        else
            echo -e "${BOLD}University Net:${RESET} ${YELLOW}No (Home/Other)${RESET}"
        fi
    fi

    if is_online; then
        echo -e "${BOLD}Internet:${RESET}       ${GREEN}ONLINE (Direct Internet Access confirmed)${RESET}"
    else
        echo -e "${BOLD}Internet:${RESET}       ${YELLOW}CAPTIVE PORTAL / OFFLINE${RESET}"
    fi
}

# 7. Setup Wizard
cmd_setup() {
    echo -e "${BOLD}${CYAN}================================================${RESET}"
    echo -e "${BOLD}${CYAN}            UniNet Fast Setup Wizard            ${RESET}"
    echo -e "${BOLD}${CYAN}================================================${RESET}\n"

    local current_ssid
    current_ssid="$(get_active_ssid)"
    current_ssid="${current_ssid:-UoM_Wireless}"

    echo -e "Detected Wi-Fi: ${BOLD}$current_ssid${RESET}\n"

    local user_in=""
    local pass_in=""

    if [ -e /dev/tty ]; then
        exec 3</dev/tty
        read -u 3 -rp "Student Username / ID: " user_in
        read -u 3 -rsp "Password: " pass_in
        echo ""
        exec 3<&-
    else
        read -rp "Student Username / ID: " user_in
        read -rsp "Password: " pass_in
        echo ""
    fi

    if [ -z "$user_in" ]; then
        echo -e "${RED}Error: Username cannot be empty.${RESET}"
        exit 1
    fi

    if [ -z "$pass_in" ]; then
        echo -e "${RED}Error: Password cannot be empty.${RESET}"
        exit 1
    fi

    mkdir -p "$CONFIG_DIR"
    cat << EOF > "$USER_CREDS"
{
  "username": "$user_in",
  "password": "$pass_in"
}
EOF
    chmod 600 "$USER_CREDS"
    echo -e "\n${GREEN}✔ Credentials saved locally in $USER_CREDS (mode 0600).${RESET}"

    # Also save to system if sudo is available
    if [ -w "/etc" ] || command -v sudo &>/dev/null; then
        sudo mkdir -p /etc/uninet 2>/dev/null || true
        sudo cp "$USER_CREDS" "$SYSTEM_CREDS" 2>/dev/null || true
        sudo chmod 600 "$SYSTEM_CREDS" 2>/dev/null || true
    fi

    echo -e "\n${BOLD}Testing connection now...${RESET}"
    cmd_login
}

# 8. Wi-Fi Multi-Factor Quality Scoring & Network Scanning
calculate_ap_score() {
    local sig="$1" freq="$2" rate="$3" active="$4"
    # 1. Signal quality (35% weight: 0 - 350 pts)
    local sig_score=$((sig * 35 / 10))

    # 2. Band bonus: 5GHz/6GHz gets +300 pts (if signal >= 20%)
    local band_bonus=0
    if [ "$freq" -ge 5000 ] && [ "$sig" -ge 20 ]; then
        band_bonus=300
    fi

    # 3. Advertised PHY rate (35% weight: min(rate, 866) / 866 * 350 pts)
    [ "$rate" -gt 866 ] && rate=866
    local rate_score=$((rate * 350 / 866))

    # 4. Active connection stability bonus (+120 pts / 12.0 pts)
    local act_bonus=0
    [ "$active" -eq 1 ] && act_bonus=120

    echo $((sig_score + band_bonus + rate_score + act_bonus))
}

scan_networks() {
    local filter_mode="${1:-campus}"
    if ! command -v nmcli &>/dev/null; then
        return
    fi

    local in_use="" ssid="" bssid="" freq="" rate="" signal=""
    while IFS= read -r line || [ -n "$line" ]; do
        local key="${line%%:*}"
        local val="${line#*:}"
        val="$(echo "$val" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

        case "$key" in
            IN-USE) in_use="$val" ;;
            SSID)   ssid="$val" ;;
            BSSID)  bssid="$val" ;;
            FREQ)   freq="$val" ;;
            RATE)   rate="$val" ;;
            SIGNAL)
                signal="$val"
                if [ -n "$ssid" ]; then
                    local include=0
                    if [ "$filter_mode" = "all" ]; then
                        include=1
                    elif is_university_network "$ssid"; then
                        include=1
                    fi

                    if [ "$include" -eq 1 ]; then
                        local is_active=0
                        [ "$in_use" = "*" ] && is_active=1

                        local freq_num="${freq//[^0-9]/}"
                        local rate_num="${rate//[^0-9]/}"
                        local sig_num="${signal//[^0-9]/}"

                        freq_num="${freq_num:-2412}"
                        rate_num="${rate_num:-54}"
                        sig_num="${sig_num:-0}"

                        local band_label="2.4 GHz"
                        if [ "$freq_num" -ge 5925 ]; then
                            band_label="6.0 GHz"
                        elif [ "$freq_num" -ge 5000 ]; then
                            band_label="5.0 GHz"
                        fi

                        local score
                        score="$(calculate_ap_score "$sig_num" "$freq_num" "$rate_num" "$is_active")"

                        printf "%05d\t%d\t%s\t%s\t%s\t%s\t%s\t%s\n" \
                            "$score" "$is_active" "$ssid" "$bssid" "$band_label" "$rate" "$signal" "$freq_num"
                    fi
                fi
                in_use=""; ssid=""; bssid=""; freq=""; rate=""; signal=""
                ;;
        esac
    done < <(nmcli -m multiline -f IN-USE,SSID,BSSID,FREQ,RATE,SIGNAL dev wifi list 2>/dev/null || true)
}

# 9. Scan & Optimize Commands
cmd_scan() {
    log "Scanning for available Wi-Fi networks..."
    local results
    results="$(scan_networks "campus")"

    if [ -z "$results" ]; then
        echo -e "${YELLOW}Notice: No university campus networks detected in range.${RESET}"
        echo -e "Showing nearby Wi-Fi networks for diagnosis:\n"
        results="$(scan_networks "all")"
    else
        echo -e "\n${BOLD}Detected Campus Networks:${RESET}"
    fi

    if [ -z "$results" ]; then
        echo "No Wi-Fi networks found."
        return
    fi

    # Sort results by score descending
    local sorted
    sorted="$(echo "$results" | sort -t$'\t' -k1,1nr)"

    # Check active score to highlight better candidates
    local active_score=0
    while IFS=$'\t' read -r sc act ss bs bnd rt sig fq; do
        if [ "$act" -eq 1 ]; then
            active_score=$sc
            break
        fi
    done <<< "$sorted"

    printf "${BOLD}%-9s %-18s %-18s %-9s %-12s %-8s %-6s${RESET}\n" \
        "STATUS" "SSID" "BSSID" "BAND" "RATE" "SIGNAL" "SCORE"
    echo "----------------------------------------------------------------------------------"

    while IFS=$'\t' read -r sc act ss bs bnd rt sig fq; do
        local display_score
        display_score="$(awk -v s="$sc" 'BEGIN { printf "%.1f", s / 10 }')"

        local status="      "
        local suffix=""
        if [ "$act" -eq 1 ]; then
            status="* ACTIVE"
        elif [ "$active_score" -gt 0 ] && [ "$sc" -ge "$((active_score + 150))" ]; then
            status="  BETTER"
            suffix=" 🚀"
        fi

        printf "%-9s %-18s %-18s %-9s %-12s %-8s %-6s%s\n" \
            "$status" "${ss:0:18}" "$bs" "$bnd" "$rt" "${sig}%" "$display_score" "$suffix"
    done <<< "$sorted"
    echo ""
}

cmd_optimize() {
    log "Evaluating campus Wi-Fi networks for optimal bandwidth and speed..."
    local results
    results="$(scan_networks "campus")"

    if [ -z "$results" ]; then
        log "No university networks detected in range. Checking standard login..."
        cmd_login "$@"
        return
    fi

    local sorted
    sorted="$(echo "$results" | sort -t$'\t' -k1,1nr)"

    local active_score=0 active_ssid="" active_bssid=""
    local top_score=0 top_ssid="" top_bssid="" top_band="" top_rate="" top_is_active=0

    # Read top candidate (first line)
    local first_line
    first_line="$(echo "$sorted" | head -n 1)"
    IFS=$'\t' read -r top_score top_is_active top_ssid top_bssid top_band top_rate _ _ <<< "$first_line"

    # Find currently active AP
    while IFS=$'\t' read -r sc act ss bs bnd rt sig fq; do
        if [ "$act" -eq 1 ]; then
            active_score=$sc
            active_ssid=$ss
            active_bssid=$bs
            break
        fi
    done <<< "$sorted"

    # Hysteresis threshold: 15.0 pts (+150 in x10 scale)
    local threshold=$((active_score + 150))

    if [ "$top_is_active" -eq 1 ] || [ "$top_bssid" = "$active_bssid" ]; then
        local display_active
        display_active="$(awk -v s="$active_score" 'BEGIN { printf "%.1f", s / 10 }')"
        log "Current connection '$active_ssid' is already the best available (Quality Score: $display_active)."
    elif [ "$top_score" -ge "$threshold" ]; then
        local diff=$((top_score - active_score))
        local display_diff
        display_diff="$(awk -v d="$diff" 'BEGIN { printf "%.1f", d / 10 }')"
        log "${BOLD}Found significantly faster connection: '$top_ssid' (+$display_diff pts higher quality, $top_band, $top_rate).${RESET}"
        log "Switching connection to '$top_ssid' ($top_bssid)..."
        if nmcli dev wifi connect "$top_ssid" bssid "$top_bssid" 2>&1; then
            echo -e "${GREEN}✔ Successfully connected to $top_ssid!${RESET}"
            sleep 1
        else
            echo -e "${YELLOW}Warning: Connection switch failed. Falling back to active network.${RESET}"
        fi
    else
        log "Current connection '$active_ssid' is optimal (candidate difference is within the 15-point stability margin)."
    fi

    log "Probing captive portal..."
    cmd_login "$@"
}

# 10. Uninstaller
cmd_uninstall() {
    echo -e "${YELLOW}Uninstalling UniNet...${RESET}"
    rm -f "$USER_CREDS"
    rm -rf "$CONFIG_DIR"

    if [ -w "/etc/NetworkManager/dispatcher.d" ] || command -v sudo &>/dev/null; then
        sudo rm -f /etc/NetworkManager/dispatcher.d/99-uninet.sh 2>/dev/null || true
        sudo rm -rf /etc/uninet 2>/dev/null || true
        sudo rm -f /usr/local/bin/uninet 2>/dev/null || true
    fi

    echo -e "${GREEN}✔ UniNet has been completely uninstalled.${RESET}"
}

# 11. CLI Route
case "$1" in
    login)
        shift
        cmd_login "$@"
        ;;
    optimize|best)
        shift
        cmd_optimize "$@"
        ;;
    scan)
        cmd_scan
        ;;
    status)
        cmd_status
        ;;
    setup)
        cmd_setup
        ;;
    uninstall)
        cmd_uninstall
        ;;
    --version|-v)
        echo "UniNet v$VERSION (Pure Bash Engine)"
        ;;
    --help|-h|*)
        echo -e "${BOLD}UniNet v$VERSION${RESET} - University Wi-Fi Auto-Connect"
        echo ""
        echo "Usage: uninet <command>"
        echo ""
        echo "Commands:"
        echo "  login        Authenticate with university Wi-Fi portal"
        echo "  optimize     Find and switch to highest speed/bandwidth campus AP"
        echo "  scan         List nearby campus Wi-Fi networks with quality scores"
        echo "  status       Check current Wi-Fi and internet status"
        echo "  setup        Configure student ID and password"
        echo "  uninstall    Remove UniNet and background hooks from machine"
        echo ""
        ;;
esac
